DEBUG=1
JWTKEY=change-me-to-a-long-random-string-of-32-chars-or-more
ORIGINS=http://localhost:5173
HOSTS=localhost,127.0.0.1
GROQ_KEY=your-groq-api-key
# local model instead of groq (ollama), set both lines. When LLM_URL is set it wins over GROQ_KEY.
# LLM_URL=http://localhost:11434/v1
# MODEL=qwen2.5:3b
# DB_URL falls back to local sqlite when DEBUG=1, set it for postgres (neon, docker)
# DB_URL=postgres://postgres:postgres@localhost:5432/catalog
